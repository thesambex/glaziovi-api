{
  "realm": "glaziovi",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "user" }
    ]
  },
  "clients": [
    {
      "clientId": "glaziovi-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "secret": "integration-client"
